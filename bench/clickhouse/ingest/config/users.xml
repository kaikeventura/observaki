<clickhouse>
  <!-- Local benchmark user. The HTTP interface is bound to localhost in the
       container profile; this account has no password and must never be used
       outside the disposable benchmark container. -->
  <users>
    <observaki>
      <password></password>
      <networks>
        <ip>::/0</ip>
      </networks>
      <profile>default</profile>
      <quota>default</quota>
    </observaki>
  </users>
</clickhouse>
