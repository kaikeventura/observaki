# Story 2.2 — ClickHouse outage during sustained ingestion.
SCENARIO_NAME=chaos-clickhouse
SCENARIO_KIND=chaos
SCENARIO_TITLE=Chaos: ClickHouse outage
SCENARIO_DESCRIPTION=Run 1M events/s for 1 hour and stop ClickHouse for 15 minutes; prove that confirmed events survive the outage and ingestion recovers.
SCENARIO_HARDWARE=Reference T1 cluster from Story 2.4 (6-12 ClickHouse, 3 VictoriaMetrics, 4-6 gateways); 1 loadgen host; 10 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway,nats,clickhouse
SCENARIO_RATE=1000000
SCENARIO_SHARDS=1
SCENARIO_PROTOCOL=http
SCENARIO_COMPRESSION=none
SCENARIO_FAILURE=clickhouse
SCENARIO_OUTAGE=15m
SCENARIO_LOSS_BUDGET_EVENTS=0
SCENARIO_METRICS=events_per_second,ingest_lag_p50_ms,ingest_lag_p95_ms,ingest_lag_p99_ms,error_rate,dropped_events,confirmed_lost_events,recovery_seconds,dlq_events,cpu_percent,ram_bytes
SCENARIO_EXPECTED=Zero confirmed events lost during a 15-minute ClickHouse outage; ingestion resumes without manual replay; lag p95 returns below 10s after recovery; the DLQ contains only permanent rejections.
SCENARIO_BLOCKED_BY_STORY=4.5
