# Story 2.2 — MVP throughput target from the G1 gate.
SCENARIO_NAME=throughput-1m
SCENARIO_KIND=throughput
SCENARIO_TITLE=Throughput 1M events/s
SCENARIO_DESCRIPTION=Sustained reference workload at 1M events/s for 1 hour; the Phase 0 gate target.
SCENARIO_HARDWARE=1 loadgen host (16 vCPU, 32 GB); single-node backend (16 vCPU, 64 GB, local NVMe); 10 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway
SCENARIO_RATE=1000000
SCENARIO_SHARDS=1
SCENARIO_PROTOCOL=http
SCENARIO_COMPRESSION=none
SCENARIO_METRICS=events_per_second,bytes_per_second,ingest_lag_p50_ms,ingest_lag_p95_ms,ingest_lag_p99_ms,error_rate,dropped_events,confirmed_lost_events,cpu_percent,ram_bytes,disk_bytes,compression_ratio,loadgen_backpressure_events,loadgen_pacing_lag_events
SCENARIO_EXPECTED=Timestamped folder with one loadgen summary and log; achieved rate within ±5% of 1M/s; zero failed or rejected events; pipeline lag p95 below 10s and zero confirmed events lost.
