# Story 2.2 — cardinality tier for small teams.
SCENARIO_NAME=cardinality-100k
SCENARIO_KIND=cardinality
SCENARIO_TITLE=Cardinality 100k active series
SCENARIO_DESCRIPTION=Hold 100k active series sending one sample per second for 1 hour with two tenants; checks the noisy-neighbor guardrail.
SCENARIO_HARDWARE=1 VictoriaMetrics node (8 vCPU, 32 GB); 1 gateway; 1 loadgen host; 1 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway,victoriametrics
SCENARIO_SERIES=100000
SCENARIO_SAMPLE_RATE=100000
SCENARIO_TENANTS=2
SCENARIO_P95_DRIFT_PERCENT=10
SCENARIO_METRICS=series_active,series_limit_errors,neighbor_p95_drift_percent,ingest_lag_p95_ms,error_rate,cpu_percent,ram_bytes
SCENARIO_EXPECTED=100k active series; tenant B p95 latency drifts less than 10% while tenant A holds the series budget; VictoriaMetrics memory stays inside the documented footprint.
SCENARIO_BLOCKED_BY_STORY=3.4
