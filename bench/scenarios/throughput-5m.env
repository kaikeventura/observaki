# Story 2.2 — sharded stress tier above a single generator process.
SCENARIO_NAME=throughput-5m
SCENARIO_KIND=throughput
SCENARIO_TITLE=Throughput 5M events/s
SCENARIO_DESCRIPTION=Sustained reference workload at 5M events/s for 1 hour using five 1M/s generator shards; a stress tier above the MVP gate.
SCENARIO_HARDWARE=2 loadgen hosts (16 vCPU, 32 GB each); reference T1 cluster from Story 2.4 (6-12 ClickHouse, 3 VictoriaMetrics, 4-6 gateways); 10-25 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway
SCENARIO_RATE=5000000
SCENARIO_SHARDS=5
SCENARIO_PROTOCOL=http
SCENARIO_COMPRESSION=none
SCENARIO_METRICS=events_per_second,bytes_per_second,ingest_lag_p50_ms,ingest_lag_p95_ms,ingest_lag_p99_ms,error_rate,dropped_events,confirmed_lost_events,cpu_percent,ram_bytes,disk_bytes,compression_ratio,loadgen_backpressure_events,loadgen_pacing_lag_events
SCENARIO_EXPECTED=Timestamped folder with five loadgen summaries and logs; aggregate rate within ±5% of 5M/s; zero failed or rejected events; pipeline lag p95 below 10s and zero confirmed events lost.
