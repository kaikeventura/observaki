# Story 2.2 — MVP query dataset at 7 days.
SCENARIO_NAME=query-10b
SCENARIO_KIND=query
SCENARIO_TITLE=Query 10B events over 7d
SCENARIO_DESCRIPTION=Seed a deterministic 10B-event dataset spanning 7 days and run the 20 dashboard queries three times; validates the MVP 10B/7d target.
SCENARIO_HARDWARE=3 ClickHouse nodes (32 vCPU, 128 GB, local NVMe); 3 VictoriaMetrics nodes; 2 gateways; 2 loadgen hosts; 10 Gbps network.
SCENARIO_DURATION=45m
SCENARIO_REQUIRES=loadgen,otlp,gateway,clickhouse,victoriametrics
SCENARIO_DATASET_EVENTS=10000000000
SCENARIO_DATASET_WINDOW=7d
SCENARIO_SEED_RATE=5000000
SCENARIO_SEED_SHARDS=5
SCENARIO_QUERY_SET=dashboard
SCENARIO_QUERY_REPETITIONS=3
SCENARIO_P95_MS=3000
SCENARIO_METRICS=query_latency_p50_ms,query_latency_p95_ms,query_latency_p99_ms,rows_read,bytes_read,cache_hit_ratio,error_rate,cpu_percent,ram_bytes
SCENARIO_EXPECTED=Timestamped folder with dataset plan, query results and run metadata; 10B seeded events over 7 days of event time; query p95 below 3000 ms and p99 below 2x p95 across 20 queries and 3 repetitions; zero query errors.
SCENARIO_BLOCKED_BY_STORY=3.5
