# Story 2.2 — cardinality at the MVP ingestion target.
SCENARIO_NAME=cardinality-1m
SCENARIO_KIND=cardinality
SCENARIO_TITLE=Cardinality 1M active series
SCENARIO_DESCRIPTION=Hold 1M active series sending one sample per second for 1 hour with two tenants; the MVP VictoriaMetrics target.
SCENARIO_HARDWARE=1 VictoriaMetrics node (16 vCPU, 64 GB); 2 gateways; 1 loadgen host; 10 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway,victoriametrics
SCENARIO_SERIES=1000000
SCENARIO_SAMPLE_RATE=1000000
SCENARIO_TENANTS=2
SCENARIO_P95_DRIFT_PERCENT=10
SCENARIO_METRICS=series_active,series_limit_errors,neighbor_p95_drift_percent,ingest_lag_p95_ms,error_rate,cpu_percent,ram_bytes
SCENARIO_EXPECTED=1M active series at 1M samples/s; tenant B p95 latency drifts less than 10%; VictoriaMetrics memory stays inside the documented footprint.
SCENARIO_BLOCKED_BY_STORY=3.4
