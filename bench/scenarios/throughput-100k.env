# Story 2.2 — small-pilot throughput tier.
SCENARIO_NAME=throughput-100k
SCENARIO_KIND=throughput
SCENARIO_TITLE=Throughput 100k events/s
SCENARIO_DESCRIPTION=Sustained reference workload at 100k events/s for 1 hour, the design-partner tier.
SCENARIO_HARDWARE=1 loadgen host (8 vCPU, 16 GB); single-node backend (8 vCPU, 32 GB, local NVMe); 1 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway
SCENARIO_RATE=100000
SCENARIO_SHARDS=1
SCENARIO_PROTOCOL=http
SCENARIO_COMPRESSION=gzip
SCENARIO_METRICS=events_per_second,bytes_per_second,ingest_lag_p50_ms,ingest_lag_p95_ms,ingest_lag_p99_ms,error_rate,dropped_events,confirmed_lost_events,cpu_percent,ram_bytes,disk_bytes,compression_ratio,loadgen_backpressure_events,loadgen_pacing_lag_events
SCENARIO_EXPECTED=Timestamped folder with one loadgen summary and log; achieved rate within ±5% of 100k/s; zero failed or rejected events; pipeline lag p95 below 10s and zero confirmed events lost.
