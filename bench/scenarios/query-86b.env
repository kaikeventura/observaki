# Story 2.2 — GA query dataset at 1M events/s for 24h.
SCENARIO_NAME=query-86b
SCENARIO_KIND=query
SCENARIO_TITLE=Query 86B events over 24h (1M/s with rollups)
SCENARIO_DESCRIPTION=Seed 86.4B deterministic events (1M/s for 24h of event time) and run the 20 dashboard queries three times with rollups; the GA 86B/24h plan.
SCENARIO_HARDWARE=Reference T1 cluster from Story 2.4: 6-12 ClickHouse nodes, 3 VictoriaMetrics nodes, 4-6 gateways; 2-3 loadgen hosts; 10-25 Gbps network; rollups 1m/5m enabled.
SCENARIO_DURATION=5h
SCENARIO_REQUIRES=loadgen,otlp,gateway,clickhouse,victoriametrics
SCENARIO_DATASET_EVENTS=86400000000
SCENARIO_DATASET_WINDOW=24h
SCENARIO_SEED_RATE=5000000
SCENARIO_SEED_SHARDS=5
SCENARIO_QUERY_SET=dashboard
SCENARIO_QUERY_REPETITIONS=3
SCENARIO_P95_MS=3000
SCENARIO_METRICS=query_latency_p50_ms,query_latency_p95_ms,query_latency_p99_ms,rows_read,bytes_read,cache_hit_ratio,error_rate,cpu_percent,ram_bytes,disk_bytes
SCENARIO_EXPECTED=Timestamped folder with dataset plan, query results and run metadata; 86.4B seeded events over 24h of event time; rollup-backed query p95 below 3000 ms and p99 below 2x p95; zero query errors.
SCENARIO_BLOCKED_BY_STORY=3.5
