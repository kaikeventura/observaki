# Story 2.2 — NATS outage during sustained ingestion.
SCENARIO_NAME=chaos-nats
SCENARIO_KIND=chaos
SCENARIO_TITLE=Chaos: NATS outage
SCENARIO_DESCRIPTION=Run 1M events/s for 30 minutes and stop NATS for 5 minutes; prove the WAL boundary does not lose confirmed events.
SCENARIO_HARDWARE=Reference T1 cluster from Story 2.4 (4+ NATS, 4-6 gateways, 6-12 ClickHouse, 3 VictoriaMetrics); 1 loadgen host; 10 Gbps network.
SCENARIO_DURATION=30m
SCENARIO_REQUIRES=loadgen,otlp,gateway,nats,clickhouse
SCENARIO_RATE=1000000
SCENARIO_SHARDS=1
SCENARIO_PROTOCOL=http
SCENARIO_COMPRESSION=none
SCENARIO_FAILURE=nats
SCENARIO_OUTAGE=5m
SCENARIO_LOSS_BUDGET_EVENTS=0
SCENARIO_METRICS=events_per_second,ingest_lag_p50_ms,ingest_lag_p95_ms,ingest_lag_p99_ms,error_rate,dropped_events,confirmed_lost_events,recovery_seconds,dlq_events,cpu_percent,ram_bytes
SCENARIO_EXPECTED=Zero confirmed events lost during a 5-minute NATS outage; producers backpressure instead of dropping; the stream replays and lag p95 returns below 10s after recovery.
SCENARIO_BLOCKED_BY_STORY=4.5
