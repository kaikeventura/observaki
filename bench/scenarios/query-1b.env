# Story 2.2 — MVP query dataset (ADR-0006 Q-02/Q-03).
SCENARIO_NAME=query-1b
SCENARIO_KIND=query
SCENARIO_TITLE=Query 1B events over 24h
SCENARIO_DESCRIPTION=Seed a deterministic 1B-event dataset spanning 24h and run the 20 dashboard queries three times; validates the MVP 1B/24h target.
SCENARIO_HARDWARE=1 ClickHouse node (16 vCPU, 64 GB, local NVMe); 1 VictoriaMetrics node (8 vCPU, 32 GB); 1 gateway; 1 loadgen host; 10 Gbps network.
SCENARIO_DURATION=20m
SCENARIO_REQUIRES=loadgen,otlp,gateway,clickhouse,victoriametrics
SCENARIO_DATASET_EVENTS=1000000000
SCENARIO_DATASET_WINDOW=24h
SCENARIO_SEED_RATE=1000000
SCENARIO_SEED_SHARDS=1
SCENARIO_QUERY_SET=dashboard
SCENARIO_QUERY_REPETITIONS=3
SCENARIO_P95_MS=1000
SCENARIO_METRICS=query_latency_p50_ms,query_latency_p95_ms,query_latency_p99_ms,rows_read,bytes_read,cache_hit_ratio,error_rate,cpu_percent,ram_bytes
SCENARIO_EXPECTED=Timestamped folder with dataset plan, query results and run metadata; 1B seeded events over 24h of event time; query p95 below 1000 ms and p99 below 2x p95 across 20 queries and 3 repetitions; zero query errors.
SCENARIO_BLOCKED_BY_STORY=3.5
