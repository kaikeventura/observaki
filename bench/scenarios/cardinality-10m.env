# Story 2.2 — cardinality stress tier for the GA plan.
SCENARIO_NAME=cardinality-10m
SCENARIO_KIND=cardinality
SCENARIO_TITLE=Cardinality 10M active series
SCENARIO_DESCRIPTION=Hold 10M active series sending one sample per second for 1 hour with two tenants; a stress tier above the MVP target.
SCENARIO_HARDWARE=3 VictoriaMetrics nodes (32 vCPU, 128 GB each); 2 gateways; 2 loadgen hosts; 10 Gbps network.
SCENARIO_DURATION=1h
SCENARIO_REQUIRES=loadgen,otlp,gateway,victoriametrics
SCENARIO_SERIES=10000000
SCENARIO_SAMPLE_RATE=10000000
SCENARIO_TENANTS=2
SCENARIO_P95_DRIFT_PERCENT=10
SCENARIO_METRICS=series_active,series_limit_errors,neighbor_p95_drift_percent,ingest_lag_p95_ms,error_rate,cpu_percent,ram_bytes,disk_bytes
SCENARIO_EXPECTED=10M active series at 10M samples/s; tenant B p95 latency drifts less than 10%; the cluster stays inside the documented memory and disk footprint.
SCENARIO_BLOCKED_BY_STORY=3.4
