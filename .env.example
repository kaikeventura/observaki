# Observaki — development environment.
#
# Copy to `.env` (ignored by git) or export the variables in your shell.
# `make dev` and `scripts/dev.sh` load `.env` automatically; `make bootstrap`
# creates it from this file when it is missing.
# Never commit real credentials.

# HTTP listen address for the API (host:port).
OBSERVAKI_HTTP_ADDR=:8080

# Log level: debug | info | warn | error.
OBSERVAKI_LOG_LEVEL=info

# Runtime environment: development | test | staging | production.
OBSERVAKI_ENV=development

# PostgreSQL control-plane URL. Optional in Phase 0 (used from Story 5.1).
# OBSERVAKI_DATABASE_URL=postgres://localhost:5432/observaki?sslmode=disable

# Directory with the static web build served by the Go binary.
OBSERVAKI_WEB_DIR=web/build

# OTLP gateway listen addresses (host:port). `observaki gateway` binds both.
OBSERVAKI_OTLP_GRPC_ADDR=:4317
OBSERVAKI_OTLP_HTTP_ADDR=:4318

# OTLP request limits. The size is enforced after decompression; the event
# limit counts spans, log records or metric data points per request.
OBSERVAKI_INGEST_MAX_REQUEST_BYTES=10485760
OBSERVAKI_INGEST_MAX_EVENTS=10000

# Attribute keys masked by the redaction pipeline (case-insensitive; '-' and
# '.' match '_') and the replacement value.
OBSERVAKI_REDACT_ATTRIBUTE_KEYS=credit_card,card_number,card.number,cc_number,pan,cvv,cvc
OBSERVAKI_REDACT_MASK=[REDACTED]

# Ingest auth snapshot (AD-19). Required by `observaki gateway`; the file has
# tenant/project tokens (SHA-256 only) and per-tenant quotas. See
# docs/dev/local-setup.md for the JSON shape.
# OBSERVAKI_INGEST_AUTH_FILE=/etc/observaki/ingest-auth.json

# Ed25519 public key (base64) for the detached snapshot signature
# (<file>.sig). Required in staging/production; optional in development.
# OBSERVAKI_INGEST_AUTH_PUBLIC_KEY=

# How often the gateway re-reads the snapshot.
OBSERVAKI_INGEST_AUTH_RELOAD_INTERVAL=30s

# Append-only JSONL audit log with a hash chain. Required in
# staging/production; development falls back to the structured log.
# OBSERVAKI_INGEST_AUDIT_FILE=/var/log/observaki/audit.jsonl
