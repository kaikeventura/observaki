# Observaki — development environment.
#
# Copy to `.env` (ignored by git) or export the variables in your shell.
# `make dev` and `scripts/dev.sh` load `.env` automatically; `make bootstrap`
# creates it from this file when it is missing.
# Never commit real credentials.

# HTTP listen address for the API (host:port).
OBSERVAKI_HTTP_ADDR=:8080

# Log level: debug | info | warn | error.
OBSERVAKI_LOG_LEVEL=info

# Runtime environment: development | test | staging | production.
OBSERVAKI_ENV=development

# PostgreSQL control-plane URL. Optional in Phase 0 (used from Story 5.1).
# OBSERVAKI_DATABASE_URL=postgres://localhost:5432/observaki?sslmode=disable

# Directory with the static web build served by the Go binary.
OBSERVAKI_WEB_DIR=web/build

# OTLP gateway listen addresses (host:port). `observaki gateway` binds both.
OBSERVAKI_OTLP_GRPC_ADDR=:4317
OBSERVAKI_OTLP_HTTP_ADDR=:4318

# OTLP request limits. The size is enforced after decompression; the event
# limit counts spans, log records or metric data points per request.
OBSERVAKI_INGEST_MAX_REQUEST_BYTES=10485760
OBSERVAKI_INGEST_MAX_EVENTS=10000

# Attribute keys masked by the redaction pipeline (case-insensitive; '-' and
# '.' match '_') and the replacement value.
OBSERVAKI_REDACT_ATTRIBUTE_KEYS=credit_card,card_number,card.number,cc_number,pan,cvv,cvc
OBSERVAKI_REDACT_MASK=[REDACTED]

# Ingest auth snapshot (AD-19). Required by `observaki gateway`; the file has
# tenant/project tokens (SHA-256 only) and per-tenant quotas. See
# docs/dev/local-setup.md for the JSON shape.
# OBSERVAKI_INGEST_AUTH_FILE=/etc/observaki/ingest-auth.json

# Ed25519 public key (base64) for the detached snapshot signature
# (<file>.sig). Required in staging/production; optional in development.
# OBSERVAKI_INGEST_AUTH_PUBLIC_KEY=

# How often the gateway re-reads the snapshot.
OBSERVAKI_INGEST_AUTH_RELOAD_INTERVAL=30s

# Append-only JSONL audit log with a hash chain. Required in
# staging/production; development falls back to the structured log.
# OBSERVAKI_INGEST_AUDIT_FILE=/var/log/observaki/audit.jsonl

# NATS JetStream WAL. `observaki gateway` fails closed when it cannot connect.
OBSERVAKI_NATS_URL=nats://127.0.0.1:4222
# OBSERVAKI_NATS_CREDENTIALS_FILE=/etc/observaki/nats.creds
# Subject tokens carry tenant/project/epoch/signal/shard (base64url for
# tenant/project). Streams are created per signal with DiscardNew retention.
OBSERVAKI_NATS_SUBJECT_PREFIX=observaki.ingest.v1
OBSERVAKI_NATS_STREAM_PREFIX=OBSERVAKI
OBSERVAKI_NATS_SHARDS=32
OBSERVAKI_NATS_STREAM_REPLICAS=1
OBSERVAKI_NATS_STREAM_MAX_AGE=24h
OBSERVAKI_NATS_STREAM_MAX_BYTES=17179869184
OBSERVAKI_NATS_STREAM_STORAGE=file
# Batching: flush at 100k events or 4 MiB, whichever comes first, and at most
# every 5ms. The WAL queue is bounded; full queues return 429 + Retry-After.
OBSERVAKI_NATS_BATCH_MAX_EVENTS=100000
OBSERVAKI_NATS_BATCH_MAX_BYTES=4194304
OBSERVAKI_NATS_BATCH_LINGER=5ms
OBSERVAKI_NATS_CONNECT_TIMEOUT=10s
OBSERVAKI_NATS_PUBLISH_TIMEOUT=5s
OBSERVAKI_NATS_MAX_PENDING_BYTES=268435456
OBSERVAKI_NATS_PUBLISH_WORKERS=8

# WAL writer (`observaki writer`). Consumes the three JetStream streams and
# writes logs/traces to ClickHouse and metrics to VictoriaMetrics. A message is
# acknowledged only after the downstream confirms the flush; an outage keeps
# the message unacked in the WAL and the writer retries with backoff.
OBSERVAKI_WRITER_ADDR=:8082
OBSERVAKI_WRITER_SPOOL_DIR=var/writer-spool
OBSERVAKI_WRITER_BATCH_MAX_EVENTS=50000
OBSERVAKI_WRITER_BATCH_LINGER=1s
OBSERVAKI_WRITER_DEDUPE_WINDOW=500000
OBSERVAKI_WRITER_ACK_WAIT=30m
OBSERVAKI_WRITER_RETENTION_DAYS=15
OBSERVAKI_WRITER_MAX_RETRY_BACKOFF=30s

# ClickHouse HTTP interface used by the writer. The application user needs
# INSERT on otel_logs/otel_traces; migrations run as an admin user.
OBSERVAKI_CLICKHOUSE_URL=http://127.0.0.1:8123
OBSERVAKI_CLICKHOUSE_DATABASE=observaki
# OBSERVAKI_CLICKHOUSE_USER=observaki
# OBSERVAKI_CLICKHOUSE_PASSWORD=
OBSERVAKI_CLICKHOUSE_TIMEOUT=2m
OBSERVAKI_CLICKHOUSE_COMPRESSION=none
OBSERVAKI_CLICKHOUSE_MAX_RETRIES=0
OBSERVAKI_CLICKHOUSE_RETRY_BACKOFF=500ms

# VictoriaMetrics remote write endpoint (the adapter appends /api/v1/write).
OBSERVAKI_VICTORIAMETRICS_URL=http://127.0.0.1:8428
OBSERVAKI_VICTORIAMETRICS_TIMEOUT=30s
OBSERVAKI_VICTORIAMETRICS_MAX_RETRIES=0
OBSERVAKI_VICTORIAMETRICS_RETRY_BACKOFF=500ms
OBSERVAKI_VICTORIAMETRICS_MAX_SERIES_PER_REQUEST=5000
